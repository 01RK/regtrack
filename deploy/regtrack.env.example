# systemd EnvironmentFile syntax; not a shell script. No export prefix.
REGTRACK_DATABASE_URL=postgresql://regtrack:CHANGE_ME@127.0.0.1:5432/regtrack
REGTRACK_MINIO_ENDPOINT=127.0.0.1:9000
REGTRACK_MINIO_BUCKET=regtrack
REGTRACK_MINIO_ACCESS_KEY=CHANGE_ME
REGTRACK_MINIO_SECRET_KEY=CHANGE_ME
# false only for object storage bound to this server's loopback interface
REGTRACK_MINIO_SECURE=false
REGTRACK_DB_POOL_MAX=16
REGTRACK_MAX_UPLOAD_MB=100
TZ=Asia/Shanghai
NO_PROXY=127.0.0.1,localhost
